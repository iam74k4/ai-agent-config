{
  // Template only. `scripts/setup.sh` / `scripts/setup.ps1` generate the
  // multi-root workspace (default: <repo-name>.code-workspace) from this file.
  // The result is gitignored, so change settings here and re-run setup.
  //
  // Setup fills in the repository name, the folders array, and the tasks array.
  "$schema": "https://json.schemastore.org/code-workspace",

  // Folder list shown in the explorer. Setup lists this repository plus every
  // Git repository that shares its parent directory. To add one by hand, edit
  // the generated file rather than this template (setup overwrites it).
  "folders": __FOLDERS__,

  // Workspace-wide settings. A repository's own .vscode/settings.json usually
  // takes precedence over these.
  "settings": {
    // Show which folder the active file belongs to in the title bar.
    "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
    // Include the directory in tab labels so same-named files stay distinct.
    "workbench.editor.labelFormat": "medium",
    // Do not open single clicks as preview tabs, so tabs survive jumping
    // between repositories.
    "workbench.editor.enablePreview": false,

    // --- Navigation ---
    // Breadcrumbs: follow the file path and the symbol hierarchy.
    "breadcrumbs.enabled": true,
    // Include symbols in breadcrumbs, for jumping to a class or function.
    "breadcrumbs.symbolPath": "on",
    // Highlight the active file in the explorer, showing which root it is under.
    "explorer.autoReveal": true,
    // Scaled-down preview of the whole file.
    "editor.minimap.enabled": true,
    "editor.minimap.showSlider": "mouseover",
    // Keep the enclosing context (class/function header) pinned while scrolling.
    "editor.stickyScroll.enabled": true,
    "editor.stickyScroll.defaultModel": "indentationBasedFolding",

    // The Outline view lives in the explorer, or use Cmd/Ctrl+Shift+O.
    // "Follow Cursor" is a toggle in the Outline view's "..." menu rather than
    // a workspace setting.
    // Always show folding controls, so the structure is easier to read.
    "editor.showFoldingControls": "always",

    // Starting directory for new integrated terminals. This assumes the
    // repositories are worked on together, so it points at the parent folder.
    "terminal.integrated.cwd": "${workspaceFolder:__REPO_NAME__}/..",
    // Lines of scrollback kept per terminal.
    "terminal.integrated.scrollback": 5000,

    // --- Git (extension view and background refresh) ---
    "git.autoFetch": true,
    // Seconds between automatic fetches (180 = about 3 minutes).
    "git.autofetchPeriod": 180,
    // Drop local references to branches deleted on the remote when fetching.
    "git.pruneOnFetch": true,

    // --- Source control panel ---
    // tree: changed files as a tree / list: flat list
    "scm.defaultViewMode": "tree",
    // Repositories shown at once in the "Source Control Repositories" view.
    "scm.repositories.visible": 10,

    // --- Line endings and trailing whitespace ---
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    // Hide from the explorer only; the files stay on disk.
    "files.exclude": {
      "**/.DS_Store": true
    },
    // When true, gitignored files are greyed out or hidden in the sidebar.
    "explorer.excludeGitIgnore": true,

    // --- File watcher exclusions (lower indexing and watcher load, for
    // directories that are never edited directly) ---
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.next/**": true,
      "**/out/**": true,
      "**/dist/**": true,
      "**/build/**": true,
      "**/target/**": true,
      "**/coverage/**": true,
      "**/.turbo/**": true,
      "**/.cache/**": true,
      "**/.venv/**": true,
      // Local venv for MarkItDown MCP (gitignored; see .cursor/docs/mcp.md).
      "**/.cursor/venv-markitdown/**": true
    },
    // --- Workspace search exclusions (Ctrl/Cmd+Shift+F). Lock files are left
    // searchable on purpose. ---
    "search.exclude": {
      "**/node_modules": true,
      "**/.next": true,
      "**/out": true,
      "**/dist": true,
      "**/build": true,
      "**/target": true,
      "**/coverage": true,
      "**/.turbo": true,
      "**/.cache": true,
      "**/.venv": true,
      "**/.cursor/venv-markitdown": true
    }
  },

  // Recommended extensions, offered when the workspace is opened. Useful for
  // keeping a team on the same tooling.
  "extensions": {
    "recommendations": [
      // Applies indentation and other settings from the root .editorconfig.
      "editorconfig.editorconfig"
    ]
  },

  // Tasks: "Terminal > Run Task", or Cmd/Ctrl+Shift+B for the default build
  // (fetch every repository). Setup generates fetch/status tasks from the
  // folders array, so adding a repository never leaves a task behind.
  "tasks": {
    "version": "2.0.0",
    "tasks": __TASKS__
  }
}
